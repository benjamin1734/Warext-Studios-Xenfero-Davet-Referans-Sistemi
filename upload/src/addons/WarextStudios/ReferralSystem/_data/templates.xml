  <template type="public" title="wrxt_referral.less" version_id="1000102" version_string="1.0.0"><![CDATA[.wrxtReferral-stats
{
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 28px;
}

.wrxtReferral-stats > div
{
    border: 1px solid @xf-borderColor;
    border-radius: @xf-borderRadiusMedium;
    padding: 14px;
    text-align: center;
}

.wrxtReferral-stats strong
{
    display: block;
    font-size: 22px;
}

.wrxtReferral-stats span
{
    display: block;
    margin-top: 4px;
    color: @xf-textColorMuted;
}

.wrxtReferral-progressScroller
{
    overflow-x: auto;
    overflow-y: hidden;
    padding: 8px 0 4px;
}

.wrxtReferral-progressMap
{
    position: relative;
    min-width: 680px;
    height: 122px;
    margin: 0 34px;
}

.wrxtReferral-progressTrack
{
    position: absolute;
    left: 0;
    right: 0;
    top: 52px;
    height: 12px;
    border-radius: 999px;
    background: @xf-borderColor;
}

.wrxtReferral-progressFill
{
    height: 100%;
    border-radius: inherit;
    background: @xf-linkColor;
    transition: width .25s ease;
}

.wrxtReferral-milestoneNode
{
    position: absolute;
    top: 0;
    width: 120px;
    transform: translateX(-50%);
    text-align: center;
    opacity: .58;
    z-index: 2;
}

.wrxtReferral-milestoneNode.is-complete
{
    opacity: 1;
}

.wrxtReferral-milestoneIcon
{
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 2px solid @xf-borderColor;
    border-radius: 50%;
    background: @xf-contentBg;
}

.wrxtReferral-milestoneNode.is-complete .wrxtReferral-milestoneIcon
{
    border-color: @xf-linkColor;
}

.wrxtReferral-milestoneImage
{
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.wrxtReferral-milestoneDot
{
    display: block;
    width: 14px;
    height: 14px;
    margin: 7px auto 4px;
    border: 3px solid @xf-contentBg;
    border-radius: 50%;
    background: @xf-borderColor;
    box-shadow: 0 0 0 2px @xf-borderColor;
}

.wrxtReferral-milestoneNode.is-complete .wrxtReferral-milestoneDot
{
    background: @xf-linkColor;
    box-shadow: 0 0 0 2px @xf-linkColor;
}

.wrxtReferral-milestoneNode strong,
.wrxtReferral-milestoneTitle
{
    display: block;
}

.wrxtReferral-milestoneTitle
{
    margin-top: 2px;
    color: @xf-textColorMuted;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.wrxtReferral-progressText
{
    margin-top: 6px;
    text-align: center;
    color: @xf-textColorMuted;
}

.wrxtReferral-copyGroup
{
    display: flex;
    width: 100%;
    min-width: 0;
    align-items: stretch;
}

.wrxtReferral-copyInput
{
    flex: 1 1 auto;
    width: 1%;
    min-width: 0;
}

.wrxtReferral-copyGroup.is-active .wrxtReferral-copyInput
{
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.wrxtReferral-copyButton
{
    flex: 0 0 auto;
    min-width: 86px;
    margin-left: -1px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

.wrxtReferral-shareGrid
{
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 20px;
    align-items: center;
}

.wrxtReferral-shareActions
{
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.wrxtReferral-qrBox
{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
}

.wrxtReferral-qrCode
{
    display: inline-block;
    padding: 10px;
    background: #fff;
    border-radius: @xf-borderRadiusMedium;
}

.wrxtReferral-qrCode img
{
    display: block;
    max-width: 180px;
    height: auto;
}

@media (max-width: @xf-responsiveMedium)
{
    .wrxtReferral-stats
    {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wrxtReferral-progressMap
    {
        min-width: 620px;
    }

    .wrxtReferral-copyButton
    {
        min-width: 78px;
    }

    .wrxtReferral-shareGrid
    {
        grid-template-columns: 1fr;
    }
}
]]></template>
</templates>
